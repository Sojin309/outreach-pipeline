# ─────────────────────────────────────────────────────────────
#  Automated Outreach Pipeline — API Keys
#  Copy this file to .env and fill in your real keys.
# ─────────────────────────────────────────────────────────────

# Stage 1 — Ocean.io
# Sign up at https://ocean.io  (requires company email)
OCEAN_API_KEY=your_ocean_api_key_here

# Stage 2 — Prospeo
# Sign up at https://app.prospeo.io/api
PROSPEO_API_KEY=your_prospeo_api_key_here

# Stage 3 — Eazyreach
# Sign up at https://eazyreach.app  (team tops up your credits)
EAZYREACH_API_KEY=your_eazyreach_api_key_here

# Stage 4 — Brevo (formerly Sendinblue)
# Sign up at https://app.brevo.com
BREVO_API_KEY=your_brevo_api_key_here

# ─────────────────────────────────────────────────────────────
#  Sender identity (used by Brevo to send emails)
# ─────────────────────────────────────────────────────────────
SENDER_NAME=Your Name
SENDER_EMAIL=you@yourdomain.com

# ─────────────────────────────────────────────────────────────
#  Pipeline settings
# ─────────────────────────────────────────────────────────────
# Max lookalike companies to process (keep low to save API credits)
MAX_COMPANIES=10

# Max prospects per company
MAX_PROSPECTS_PER_COMPANY=3

# Delay between API calls in seconds (avoid rate limits)
API_DELAY=1.0
